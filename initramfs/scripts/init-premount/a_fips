#!/bin/sh
#
# Boot-time premount: start the FIPS node and wait for its mesh address.
#
# The name begins with "a_" so that this script sorts ahead of the
# dropbear script, which binds to an address this one has to create
# first. That ordering is a filename accident rather than a declared
# dependency; README.Debian says why, and what happens if it breaks.

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
    ;;
esac

# Provided inside the initramfs at boot; not present to be read here.
# shellcheck source=/dev/null
. /scripts/functions

CONFIG=/etc/fips/fips.yaml
EXPECTED_FILE=/etc/fips/mesh-address
NPUB_FILE=/etc/fips/mesh-npub
PIDFILE=/run/fips.pid
LOGFILE=/run/fips.log
IFACE=fips0
NET_PIDFILE=/run/fips-network.pid
NET_LOGFILE=/run/fips-network.log
DROPBEAR_PIDFILE=/run/dropbear.pid

# Seconds between attempts at the network when one fails at once, as it
# does with no network device, so the retry cannot spin.
NET_RETRY_INTERVAL=10

# Twenty seconds, in whole-second steps. A fractional sleep would work
# here, because dropbear-initramfs forces BUSYBOX=y through its
# conf-hook and mkinitramfs reads conf-hooks.d after initramfs.conf. It
# is avoided anyway: whole seconds also work under klibc, and the finer
# granularity buys nothing against a wait measured in seconds.
WAIT_ITERATIONS=20
WAIT_INTERVAL=1

[ -x /usr/bin/fips ] || exit 0

fips_warn() {
    echo "fips-initramfs: WARNING:" "$@" >&2
}

# The global-scope address currently on the mesh interface, or empty.
#
# The first line is taken with sed and not with head, because head is not
# in every initramfs. Ubuntu's busybox-initramfs 1.36.1 has no head
# applet and the image carries no head binary, so the pipeline printed
# "head: not found" and returned empty on every call. That is worse than
# a crash: the wait loop below then runs to its limit on every boot, the
# script reports that remote unlock is unavailable when it is not, and
# the address comparison it exists to make is never reached. Debian's
# image does carry head, so the fault is invisible here. sed is already
# used on the line above, so it is present wherever this pipeline runs at
# all.
current_address() {
    ip -6 addr show dev "$IFACE" scope global 2>/dev/null \
        | sed -n 's|^[[:space:]]*inet6 \([0-9a-fA-F:]*\)/.*|\1|p' \
        | sed -n '1p'
}

# Whether any attempt at configure_networking has succeeded.
#
# initramfs-tools writes one of these files for each interface it
# configures, and tests for the same files itself to decide it is done.
network_configured() {
    for _nc_file in /run/net-*.conf /run/net6-*.conf; do
        [ -e "$_nc_file" ] && return 0
    done
    return 1
}

# Wait for dropbear's boot script to finish its one attempt at the network.
#
# That script runs configure_networking and then execs dropbear in the same
# process, so the process's executable becomes dropbear exactly when the
# attempt is over. Its init-bottom script watches for the same change. The
# process name cannot be used instead: the boot script is itself a file
# called dropbear, so the name reads dropbear before the exec as well.
# readlink is dropbear's own requirement, since its init-bottom script
# cannot run without it, and it is a busybox applet on all five
# distributions.
#
# The pid file cannot exist yet when this starts: dropbear's script sorts
# after this one and has not run. It is waited for, and after a minute with
# no file dropbear is taken to be absent.
wait_for_dropbear_attempt() {
    _wd_exe=$(readlink -f /sbin/dropbear 2>/dev/null) || return 0
    _wd_i=0
    while [ ! -s "$DROPBEAR_PIDFILE" ]; do
        [ "$_wd_i" -lt 60 ] || return 0
        sleep 1
        _wd_i=$((_wd_i + 1))
    done
    _wd_pid=$(cat "$DROPBEAR_PIDFILE" 2>/dev/null) || return 0
    while _wd_now=$(readlink -f "/proc/$_wd_pid/exe" 2>/dev/null); do
        [ "$_wd_now" != "$_wd_exe" ] || return 0
        sleep 5
    done
}

# Keep trying to bring the network up until it comes.
#
# initramfs-tools gives up on DHCP after 265 to 300 seconds and does not try
# again, so without this a cable plugged in after that never gets a network
# and remote unlock stays unavailable until the next boot. Each attempt runs
# in its own subshell because configure_networking keeps state in shell
# variables, and a second call in the same shell would start from what the
# first one left. Its output goes to a file: on a text console it would
# otherwise be written over the passphrase prompt every few minutes.
network_retry() {
    wait_for_dropbear_attempt
    while ! network_configured; do
        ( configure_networking )
        network_configured || sleep "$NET_RETRY_INTERVAL"
    done
}

modprobe tun || fips_warn "modprobe tun failed; the node will come up with no interface."

# The network is not configured in the foreground here. dropbear's boot
# script makes the first attempt in the background, and this script only
# retries once that attempt has failed.
#
# This script used to call configure_networking in the foreground, and
# premount scripts run one at a time, so the console passphrase prompt
# waited for it. With no network link that meant waiting for DHCP to give
# up, four and a half to five minutes depending on the release, and three
# more if no network device exists at all. A machine with its cable
# unplugged looked hung.
#
# The node does not need the network in order to start. Its UDP socket
# binds the wildcard address, fips0 takes its address from the identity,
# and an auto-connect peer that cannot be reached yet is retried without
# limit, so the node joins the mesh whenever a link comes up.
#
# No retry is started when the kernel command line turns networking off,
# or for an NFS root, where dropbear's script configures the network in the
# foreground before anything else runs. init-bottom stops the retry.
case "${IP-}" in
    none|off)
        ;;
    *)
        if [ "${BOOT-}" != nfs ]; then
            network_retry </dev/null >>"$NET_LOGFILE" 2>&1 &
            echo $! > "$NET_PIDFILE"
        fi
        ;;
esac

log_begin_msg "Starting the FIPS node"
/usr/bin/fips --config "$CONFIG" >"$LOGFILE" 2>&1 &
echo $! > "$PIDFILE"
log_end_msg

expected=$(cat "$EXPECTED_FILE" 2>/dev/null) || expected=""
# The name a connection must use. Absent when the identity predates
# fips.pub, and the address is then reported on its own.
npub=$(cat "$NPUB_FILE" 2>/dev/null) || npub=""

i=0
address=""
while [ "$i" -lt "$WAIT_ITERATIONS" ]; do
    address=$(current_address)
    [ -n "$address" ] && break
    sleep "$WAIT_INTERVAL"
    i=$((i + 1))
done

# Three failures reach this point and none of them stops the boot. Each
# leaves the console passphrase prompt as the way in, which is the whole
# reason the wait is bounded.
if [ -z "$address" ]; then
    fips_warn "$IFACE has no global address after the wait; remote unlock is unavailable."
    fips_warn "A daemon that runs without an interface means tun.enabled is"
    fips_warn "false or the tun module is absent."
    # Print the daemon's own last words rather than telling someone to go
    # and read them. The advice this replaced was to open $LOGFILE from a
    # console shell, which is not reachable: this path leaves the machine
    # at the passphrase prompt with no shell, and on a remote machine
    # there is no console to use anyway. Bounded, because the console is
    # the only output this script has and a daemon that failed at startup
    # says so in a few lines.
    if [ -s "$LOGFILE" ]; then
        # The first lines, not the last, and deliberately: a daemon that
        # fails at startup says why in its opening lines, and reaching
        # for tail here would risk exactly the fault that produced this
        # script's sed above. tail is no more guaranteed than head.
        fips_warn "the first lines of $LOGFILE follow:"
        sed -n '1,10p' "$LOGFILE" 2>/dev/null \
            | while IFS= read -r _line; do
                  fips_warn "  $_line"
              done
    else
        fips_warn "$LOGFILE is empty; the daemon wrote nothing at all."
    fi
elif [ -z "$expected" ]; then
    fips_warn "no expected address in the image; cannot check the identity."
    fips_warn "$IFACE came up at $address."
elif [ "$address" != "$expected" ]; then
    fips_warn "$IFACE came up at $address, not the expected $expected."
    fips_warn "The node is running under a different identity, so dropbear is"
    fips_warn "bound to an address that does not exist. Remote unlock is unavailable."
elif [ -n "$npub" ]; then
    # Both, and the name first. Connecting to the bare address never
    # works: resolving <npub>.fips through a FIPS DNS responder is what
    # drives the mesh lookup, so a bare address makes no lookup and the
    # connection fails with no route. The address is here to be checked
    # against, not to be dialled.
    log_success_msg "FIPS node up at $npub.fips ($address)"
else
    log_success_msg "FIPS node up at $address"
fi
