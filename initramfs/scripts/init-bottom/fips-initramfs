#!/bin/sh
#
# Boot-time bottom: stop the FIPS node and remove its interface before
# switch_root.
#
# PREREQ names dropbear so the SSH session closes before the transport
# that carries it disappears. Unlike the premount case this is a declared
# dependency and is honoured.
#
# Anything still running here holds a reference to the initramfs across
# switch_root. The daemon proper starts under systemd afterwards, and may
# use an identity different from this one.

PREREQ="dropbear"

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
    ;;
esac

# Provided inside the initramfs at boot; not present to be read here.
# shellcheck source=/dev/null
. /scripts/functions

PIDFILE=/run/fips.pid
IFACE=fips0
# Five seconds, in whole-second steps, for the same reason as the
# premount wait. The daemon drains its peers with a two-second timeout,
# so a healthy exit lands well inside this.
SHUTDOWN_ITERATIONS=5
SHUTDOWN_INTERVAL=1
NET_PIDFILE=/run/fips-network.pid

# The pids of a process's direct children.
#
# The fields of /proc/<pid>/stat begin pid, command in parentheses, state,
# parent pid. dropbear's own init-bottom script finds its SSH sessions from
# the same fields with sed, which every image carries; ps is not assumed.
children() {
    sed -n "s/^\([0-9]*\) (.*) . $1 .*/\1/p" /proc/[0-9]*/stat 2>/dev/null
}

# Stop a process and everything below it, parents first, so that no
# process can start another child after its own children have been listed.
stop_tree() {
    kill -STOP "$1" 2>/dev/null || return 0
    for _st_child in $(children "$1"); do
        stop_tree "$_st_child"
    done
}

# Kill a stopped tree, children first. A killed parent's children pass to
# init at once and can no longer be found as its children, so killing
# parents first leaves the rest of the tree stopped and alive.
kill_tree() {
    for _kt_child in $(children "$1"); do
        kill_tree "$_kt_child"
    done
    kill -KILL "$1" 2>/dev/null
}

# Stop the premount script's network retry, if it is still running.
#
# It is still running only if no attempt has brought the network up, which
# means the disk was unlocked at the console. The attempt in progress is
# dhcpcd or ipconfig in a subshell of the retry, and ipconfig ignores TERM,
# so the whole tree is stopped and then killed rather than asked to exit.
# Left alone it would keep configuring interfaces from the discarded
# initramfs after the real system has started.
netpid=$(cat "$NET_PIDFILE" 2>/dev/null) || netpid=""
if [ -n "$netpid" ] && kill -0 "$netpid" 2>/dev/null; then
    log_begin_msg "Stopping the network retry"
    stop_tree "$netpid"
    kill_tree "$netpid"
    log_end_msg
fi
rm -f "$NET_PIDFILE"

pid=$(cat "$PIDFILE" 2>/dev/null) || pid=""

if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    log_begin_msg "Stopping the FIPS node"
    kill -TERM "$pid" 2>/dev/null || true

    # The daemon drains its peers before it exits. Waiting for the exit
    # keeps the interface deletion below from racing a live data path.
    i=0
    while [ "$i" -lt "$SHUTDOWN_ITERATIONS" ] && kill -0 "$pid" 2>/dev/null; do
        sleep "$SHUTDOWN_INTERVAL"
        i=$((i + 1))
    done

    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
    log_end_msg
fi

ip link del "$IFACE" 2>/dev/null || true
rm -f "$PIDFILE"

exit 0
