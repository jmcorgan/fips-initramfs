# debhelper build products. dpkg-buildpackage writes the staging tree
# here and the artifacts one directory up, outside the repository.
/debian/fips-initramfs/
/debian/files
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log
/debian/debhelper-build-stamp

# The FIPS release .deb the build takes its binaries from, and the
# checksums it is verified against. Downloaded by debian/fetch-fips-deb.sh.
/vendor/

# Nix build products from the module under nixos/.
/nixos/result
/nixos/result-*
